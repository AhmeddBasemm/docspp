---
import { resolveIcon } from '@the-package-labs/idocs-core/node'

interface Props {
  /** Any name `idocs icons search` finds: `lucide:copy`, `simple-icons:github`, `postgresql`. */
  name: string
  class?: string
}

const { name, class: className } = Astro.props
const { icon } = resolveIcon(name)
if (!icon) throw new Error(`Icon "${name}" was not found in the bundled icon sets.`)
---

<svg
  class={className}
  viewBox={icon.viewBox}
  aria-hidden="true"
  focusable="false"
  set:html={icon.body}
/>

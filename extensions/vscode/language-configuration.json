{
  "comments": { "lineComment": "#" },
  "brackets": [["{", "}"], ["[", "]"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["\"", "\""], ["'", "'"]],
  "folding": {
    "offSide": true,
    "markers": { "start": "^\\s*#\\s*region\\b", "end": "^\\s*#\\s*endregion\\b" }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*.*(:|-) ?(&\\w+)?(\\{[^}\"']*|\\([^)\"']*)?$",
    "decreaseIndentPattern": "^\\s+\\}$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*- \\S.*$",
      "afterText": "^\\s*$",
      "action": { "indent": "none", "appendText": "- " }
    }
  ],
  "wordPattern": "[A-Za-z0-9_.-]+"
}

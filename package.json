{
  "name": "docspp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter docspp-docs build",
    "build:all": "pnpm build:packages && pnpm --filter docspp-docs build && pnpm --filter my-docs build",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "changeset": "changeset",
    "check": "tsx packages/cli/src/bin.ts check apps/docs templates/starter",
    "vscode:build": "pnpm --filter docspp-vscode build",
    "vscode:package": "pnpm --filter docspp-vscode package",
    "vscode:test": "pnpm --filter docspp-vscode test:integration",
    "dev": "pnpm --filter docspp-docs dev",
    "dev:template": "pnpm --filter my-docs dev",
    "format": "biome check --write .",
    "docspp": "tsx packages/cli/src/bin.ts",
    "lint": "biome check .",
    "preview": "pnpm --filter docspp-docs preview",
    "release": "pnpm build:packages && changeset publish",
    "template": "node scripts/template.mjs",
    "test": "vitest run",
    "test:e2e": "pnpm build && vitest run -c vitest.e2e.config.ts",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify:pack": "node scripts/verify-pack.mjs",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "homepage": "https://github.com/AhmeddBasemm/docspp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhmeddBasemm/docspp.git"
  },
  "license": "MIT"
}

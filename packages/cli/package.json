{
  "name": "@docspp/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "docspp": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node ../../scripts/build.mjs"
  },
  "dependencies": {
    "@docspp/core": "workspace:^"
  },
  "description": "The docspp command line: check, list, schema, icons search, new.",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhmeddBasemm/docspp.git"
  },
  "homepage": "https://github.com/AhmeddBasemm/docspp#readme",
  "publishConfig": {
    "access": "public",
    "bin": {
      "docspp": "./dist/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  }
}

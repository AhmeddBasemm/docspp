{
  "name": "@packagelab/docspp-astro",
  "version": "0.2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./Diagram.astro": "./src/Diagram.astro",
    "./starlight.css": "./src/starlight.css",
    "./virtual": {
      "types": "./src/virtual.d.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node ../../scripts/build.mjs"
  },
  "dependencies": {
    "@packagelab/docspp-core": "workspace:^",
    "@packagelab/docspp-react": "workspace:^"
  },
  "peerDependencies": {
    "astro": ">=6"
  },
  "devDependencies": {
    "astro": "^7.0.0",
    "vite": "*"
  },
  "description": "Astro integration for docspp: compiles diagrams/ at build time and provides the <Diagram> component.",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhmeddBasemm/docspp.git"
  },
  "homepage": "https://github.com/AhmeddBasemm/docspp#readme",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./Diagram.astro": "./dist/Diagram.astro",
      "./starlight.css": "./dist/starlight.css",
      "./virtual": {
        "types": "./dist/virtual.d.ts"
      }
    }
  },
  "license": "MIT"
}

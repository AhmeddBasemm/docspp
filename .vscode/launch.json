{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "idocs extension (apps/docs)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/vscode",
        "${workspaceFolder}/apps/docs"
      ],
      "outFiles": ["${workspaceFolder}/extensions/vscode/dist/**/*.js"],
      "preLaunchTask": "idocs: build extension"
    }
  ]
}
